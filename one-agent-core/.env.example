# OpenAI 兼容端点（DeepSeek / Ollama / LM Studio / vLLM / OpenAI）
# 默认指向本机 Ollama（无需 key）
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen2.5-7b-64k

# Anthropic 原生 API（需要 key）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# 演示配置
DEMO_PROVIDER=openai-compatible
DEMO_MESSAGE=用一句话介绍你自己
