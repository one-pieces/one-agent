{
  "name": "@one-agent/core",
  "version": "0.1.0",
  "description": "one-agent 内核层：自研 LLM provider 调用层 + agent 逻辑（纯 TS，零框架依赖）",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env scripts/demo.ts",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "chat": "node --env-file-if-exists=.env scripts/chat.ts",
    "mcp-demo": "node scripts/mcp-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "eventsource-parser": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
